package com.seal.sealsystem.controller;
import com.seal.sealsystem.entity.Score;
import com.seal.sealsystem.repository.ScoreRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/score")
@RequiredArgsConstructor
public class ScoreController {

    private final ScoreRepository repo;

    @PostMapping
    public Score create(@RequestBody Score s) {
        return repo.save(s);
    }
}
