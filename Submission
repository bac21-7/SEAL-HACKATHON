package com.seal.sealsystem.entity;
import jakarta.persistence.*;
import lombok.Data;
@Entity
@Data
public class Submission {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @ManyToOne
    private Team team;

    @ManyToOne
    private Round round;

    private String repoUrl;
    private String demoUrl;
    private String reportUrl;
}
