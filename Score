package com.seal.sealsystem.entity;
import jakarta.persistence.*;
import lombok.Data;
@Entity
@Data
public class Score {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @ManyToOne
    private Submission submission;

    @ManyToOne
    private User judge;

    private Double uiScore;
    private Double backendScore;
    private Double ideaScore;
}
