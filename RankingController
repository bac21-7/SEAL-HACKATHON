package com.seal.sealsystem.controller;
import com.seal.sealsystem.entity.Submission;
import com.seal.sealsystem.service.RankingService;
import lombok.RequiredArgsConstructor;
import org.springframework.web.bind.annotation.*;

import java.util.List;
@RestController
@RequestMapping("/ranking")
@RequiredArgsConstructor
public class RankingController {

    private final RankingService rankingService;

    @GetMapping("/{roundId}")
    public List<Submission> getRanking(@PathVariable Long roundId) {
        return rankingService.ranking(roundId);
    }
}
